<mujoco model="bimanual_tabletop_challenge">
  <compiler angle="radian" meshdir="." autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <!-- Shared Motor and Friction Defaults -->
  <default>
    <default class="so101_new_calib">
      <joint damping="1" frictionloss="0.1" armature="0.005"/>
      <position kp="50"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
      </default>
    </default>
    <default class="sts3215">
      <geom contype="0" conaffinity="0"/>
      <joint damping="0.60" frictionloss="0.052" armature="0.028"/>
      <position kp="998.22" kv="2.731" forcerange="-2.94 2.94"/>
    </default>
    <default class="backlash">
      <joint damping="0.01" frictionloss="0" armature="0.01" limited="true" range="-0.008726 0.008726"/>
    </default>
  </default>

  <!-- 3D Meshes & Materials -->
  <asset>
    <!-- SO-101 Robot Meshes -->
    <mesh file="SO-ARM100/Simulation/SO101/assets/waveshare_mounting_plate_so101_v2.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/sts3215_03a_v1.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/motor_holder_so101_base_v1.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/wrist_roll_follower_so101_v1.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/moving_jaw_so101_v1.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/base_motor_holder_so101_v1.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/upper_arm_so101_v1.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/wrist_roll_pitch_so101_v2.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/under_arm_so101_v1.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/rotation_pitch_so101_v1.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/motor_holder_so101_wrist_v1.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/sts3215_03a_no_horn_v1.stl"/>
    <mesh file="SO-ARM100/Simulation/SO101/assets/base_so101_v2.stl"/>

    <!-- High-Fidelity 3D Tableware Meshes -->
    <mesh name="plate_mesh" file="plate_ready.obj"/>
    <mesh name="bottle_mesh" file="bottle_ready.obj"/>
    <mesh name="mug_mesh" file="mug_ready.obj"/>
    <mesh name="spoon_mesh" file="spoon_ready.obj"/>
    <mesh name="fork_mesh" file="fork_ready.obj"/>

    <!-- Robot Materials -->
    <material name="base_motor_holder_so101_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="base_so101_v2_material" rgba="1 0.82 0.12 1"/>
    <material name="sts3215_03a_v1_material" rgba="0.1 0.1 0.1 1"/>
    <material name="waveshare_mounting_plate_so101_v2_material" rgba="1 0.82 0.12 1"/>
    <material name="motor_holder_so101_base_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="rotation_pitch_so101_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="upper_arm_so101_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="under_arm_so101_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="motor_holder_so101_wrist_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="sts3215_03a_no_horn_v1_material" rgba="0.1 0.1 0.1 1"/>
    <material name="wrist_roll_pitch_so101_v2_material" rgba="1 0.82 0.12 1"/>
    <material name="wrist_roll_follower_so101_v1_material" rgba="1 0.82 0.12 1"/>
    <material name="moving_jaw_so101_v1_material" rgba="1 0.82 0.12 1"/>

    <!-- Scene & Tableware Materials -->
    <material name="wood_table_mat" rgba="0.38 0.26 0.18 1" specular="0.3" shininess="0.4"/>
    <material name="table_legs_mat" rgba="0.15 0.15 0.15 1"/>
    <material name="drawer_cabinet_mat" rgba="0.48 0.34 0.22 1" specular="0.4" shininess="0.5"/>
    <material name="drawer_face_mat" rgba="0.94 0.94 0.95 1" specular="0.6" shininess="0.7"/>
    <material name="ceramic_white_mat" rgba="0.96 0.96 0.97 1" specular="0.8" shininess="0.9"/>
    <material name="ceramic_blue_mat" rgba="0.18 0.38 0.78 1" specular="0.6" shininess="0.7"/>
    <material name="bottle_blue_mat" rgba="0.15 0.65 0.85 0.85" specular="0.8" shininess="0.9"/>
    <material name="silver_metal_mat" rgba="0.85 0.85 0.88 1" specular="0.9" shininess="0.95"/>
  </asset>

  <!-- Tabletop World -->
  <worldbody>
    <light name="main_light" diffuse="0.85 0.85 0.85" pos="0 0 3" dir="0 0 -1" castshadow="true"/>
    <light name="fill_light" diffuse="0.4 0.4 0.4" pos="1.5 -1.0 2.5" dir="-0.5 0.3 -0.8"/>
    <geom name="ground" type="plane" size="2.5 2.5 0.1" rgba="0.93 0.93 0.94 1"/>

    <!-- Modern Wooden Dining / Work Table (Surface at z = 0.70m) -->
    <body name="dining_table" pos="0 0 0">
      <!-- Main Tabletop Slab -->
      <geom name="table_surface" type="box" size="0.60 0.45 0.02" pos="0 0 0.68" material="wood_table_mat" friction="1.2 0.01 0.001"/>
      <!-- Beveled Edges -->
      <geom name="table_edge_left" type="box" size="0.60 0.008 0.018" pos="0 0.442 0.68" rgba="0.32 0.22 0.15 1" contype="0" conaffinity="0"/>
      <geom name="table_edge_right" type="box" size="0.60 0.008 0.018" pos="0 -0.442 0.68" rgba="0.32 0.22 0.15 1" contype="0" conaffinity="0"/>
      <!-- 4 Tapered Modern Black Legs -->
      <geom name="leg1" type="cylinder" size="0.022 0.33" pos="0.52 0.38 0.33" material="table_legs_mat"/>
      <geom name="leg2" type="cylinder" size="0.022 0.33" pos="-0.52 0.38 0.33" material="table_legs_mat"/>
      <geom name="leg3" type="cylinder" size="0.022 0.33" pos="0.52 -0.38 0.33" material="table_legs_mat"/>
      <geom name="leg4" type="cylinder" size="0.022 0.33" pos="-0.52 -0.38 0.33" material="table_legs_mat"/>
    </body>

    <!-- Overhead Camera for Vision / VLA reasoning -->
    <camera name="overhead_cam" pos="0 0 1.6" euler="0 0 0"/>

    <!-- 3D Upright Ceramic Mug (Standing flat on table in Arm B's reach) -->
    <body name="mug" pos="0.06 0.18 0.70">
      <freejoint/>
      <!-- Visual 3D Mesh -->
      <geom type="mesh" mesh="mug_mesh" material="ceramic_blue_mat" contype="0" conaffinity="0" group="2"/>
      <!-- Physical Collision Cylinder (aligned with visual cylinder) -->
      <!-- Group 1 only: the mug is pinched by the finger-base pads; the fingertip
           pads (group 2) would otherwise sweep the mug body during the pitched
           descent onto a rotated handle. Fingertips have no mug collision, like
           the original model. -->
      <geom name="mug_geom" type="cylinder" size="0.044 0.048" pos="0 -0.018 0.048" mass="0.12" friction="1.8 0.01 0.001" rgba="0 0 0 0" group="3"/>
      <!-- Physical Collision Handle (capsule spanning vertical handle loop) -->
      <geom name="mug_handle" type="capsule" fromto="0 0.050 0.030 0 0.050 0.075" size="0.010" mass="0.02" friction="2.0 0.01 0.001" rgba="0 0 0 0" group="3"/>
      <site name="mug_site" pos="0 -0.018 0.048" rgba="0 0 0 0" group="3"/>
      <site name="mug_handle_site" pos="0 0.050 0.065" size="0.005" rgba="0 0 0 0" group="3"/>
    </body>

    <!-- Fully Covered Modern Desktop Drawer Cabinet (Comfortable reach from Arm A) -->
    <body name="drawer_unit" pos="0.22 -0.22 0.70">
      <!-- Outer Cabinet Casing (Covering top, sides, and back) -->
      <!-- Bottom Base Plate -->
      <geom name="cabinet_bottom" type="box" size="0.13 0.13 0.004" pos="0 0 0.004" material="drawer_cabinet_mat" contype="0" conaffinity="0"/>
      <!-- Top Roof Cover -->
      <geom name="cabinet_top" type="box" size="0.13 0.13 0.005" pos="0 0 0.056" material="drawer_cabinet_mat" contype="0" conaffinity="0"/>
      <!-- Left Wall -->
      <geom name="cabinet_left" type="box" size="0.13 0.005 0.026" pos="0 0.125 0.030" material="drawer_cabinet_mat" contype="0" conaffinity="0"/>
      <!-- Right Wall -->
      <geom name="cabinet_right" type="box" size="0.13 0.005 0.026" pos="0 -0.125 0.030" material="drawer_cabinet_mat" contype="0" conaffinity="0"/>
      <!-- Back Wall -->
      <geom name="cabinet_back" type="box" size="0.005 0.13 0.026" pos="0.125 0 0.030" material="drawer_cabinet_mat" contype="0" conaffinity="0"/>

      <!-- Movable Drawer Section (Slides towards -X, out from under the roof) -->
      <body name="sliding_tray" pos="0 0 0.008">
        <joint name="drawer_slide" type="slide" axis="-1 0 0" range="0 0.16" damping="1.5" frictionloss="1.0"/>
        <!-- Spacious Tray Floor (Carrying the plate with ample clearance) -->
        <geom name="tray_floor" type="box" size="0.12 0.12 0.004" pos="0 0 0.004" rgba="0.75 0.62 0.48 1" friction="1.2 0.01 0.001"/>
        <!-- Rear Lip -->
        <geom name="tray_back_lip" type="box" size="0.004 0.115 0.016" pos="0.116 0 0.016" rgba="0.65 0.52 0.38 1"/>
        <!-- Front White Drawer Face -->
        <geom name="tray_front_face" type="box" size="0.006 0.125 0.024" pos="-0.120 0 0.024" material="drawer_face_mat"/>

        <!-- Prominent Ergonomic D-Handle with 22mm clearance for reliable hook/pull -->
        <geom name="handle_post_left" type="cylinder" size="0.004 0.014" pos="-0.136 0.040 0.024" euler="0 1.5708 0" material="table_legs_mat"/>
        <geom name="handle_post_right" type="cylinder" size="0.004 0.014" pos="-0.136 -0.040 0.024" euler="0 1.5708 0" material="table_legs_mat"/>
        <geom name="drawer_handle" type="cylinder" size="0.007 0.045" pos="-0.150 0 0.024" euler="1.5708 0 0" material="table_legs_mat" friction="2.0 0.01 0.001"/>
        <site name="drawer_handle_site" pos="-0.150 0 0.024" rgba="0 0 0 0" group="3"/>
      </body>
    </body>

    <!-- 3D Realistic Ceramic Plate (Starts enclosed inside the covered drawer) -->
    <body name="plate" pos="0.22 -0.22 0.72">
      <freejoint/>
      <!-- Visual 3D Mesh (scaled to 12cm diameter) -->
      <geom type="mesh" mesh="plate_mesh" material="ceramic_white_mat" contype="0" conaffinity="0" group="2"/>
      <!-- Physical Collision Disc (matching 12cm diameter) -->
      <geom name="plate_geom" type="cylinder" size="0.060 0.006" pos="0 0 0.006" mass="0.10" friction="1.5 0.01 0.001" rgba="0 0 0 0" group="3"/>
      <site name="plate_site" pos="0 0 0.006" rgba="0 0 0 0" group="3"/>
    </body>

    <!-- 3D Realistic Clean Water Bottle (Arm A pouring into Arm B's mug) -->
    <body name="water_bottle" pos="0.135 -0.06 0.70">
      <freejoint/>
      <!-- Visual 3D Mesh -->
      <geom type="mesh" mesh="bottle_mesh" material="bottle_blue_mat" contype="0" conaffinity="0" group="2"/>
      <!-- Physical Collision Shapes: Main Body + Graspable Neck/Cap -->
      <!-- contype/conaffinity 3 = default group 1 plus fingertip-pad group 2 -->
      <geom name="bottle_body" type="cylinder" size="0.024 0.050" pos="0 0 0.050" mass="0.10" friction="1.8 0.01 0.001" rgba="0 0 0 0" group="3" contype="3" conaffinity="3"/>
      <geom name="bottle_geom" type="cylinder" size="0.016 0.030" pos="0 0 0.130" mass="0.05" friction="1.8 0.01 0.001" rgba="0 0 0 0" group="3" contype="3" conaffinity="3"/>
      <site name="bottle_site" pos="0 0 0.130" rgba="0 0 0 0" group="3"/>
    </body>

    <!-- 3D Realistic Spoon (Dinner setting utensil) -->
    <body name="spoon" pos="0.22 0.08 0.70">
      <freejoint/>
      <geom type="mesh" mesh="spoon_mesh" material="silver_metal_mat" mass="0.02" friction="1.2 0.01 0.001"/>
      <site name="spoon_site" pos="0 0 0.005" rgba="0 0 0 0" group="3"/>
    </body>

    <!-- 3D Realistic Fork (Dinner setting utensil) -->
    <body name="fork" pos="0.22 0.02 0.70">
      <freejoint/>
      <geom type="mesh" mesh="fork_mesh" material="silver_metal_mat" mass="0.02" friction="1.2 0.01 0.001"/>
      <site name="fork_site" pos="0 0 0.005" rgba="0 0 0 0" group="3"/>
    </body>
  </worldbody>

  <!-- Contact Exclusions: strictly for drawer casing vs plate at reset, and table vs base -->
  <contact>
    <exclude body1="plate" body2="drawer_unit"/>
    <exclude body1="sliding_tray" body2="drawer_unit"/>
    <exclude body1="water_bottle" body2="sliding_tray"/>
    <exclude body1="dining_table" body2="a_base"/>
    <exclude body1="dining_table" body2="b_base"/>
    <!-- Internal robot bracket self-clearances -->
    <exclude body1="a_lower_arm" body2="a_shoulder"/>
    <exclude body1="b_lower_arm" body2="b_shoulder"/>
    <exclude body1="a_wrist" body2="a_shoulder"/>
    <exclude body1="b_wrist" body2="b_shoulder"/>
    <exclude body1="a_upper_arm" body2="a_wrist"/>
    <exclude body1="b_upper_arm" body2="b_wrist"/>
    <exclude body1="a_upper_arm" body2="a_gripper_base"/>
    <exclude body1="b_upper_arm" body2="b_gripper_base"/>
  </contact>

  <!-- Top-level robot includes -->
  <include file="SO-ARM100/Simulation/SO101/so101_arm_a.xml"/>
  <include file="SO-ARM100/Simulation/SO101/so101_arm_b.xml"/>

  <!-- Dynamic Grasp Welds for realistic robotic manipulation (activated only during active grip) -->
  <equality>
    <weld name="weld_plate_drawer" body1="sliding_tray" body2="plate" active="true"/>
    <weld name="weld_drawer" body1="a_gripper_base" body2="sliding_tray" active="false"/>
    <weld name="weld_plate" body1="a_gripper_base" body2="plate" active="false"/>
    <!-- Stiffer solref (6 ms vs the 20 ms default): a held vessel must not sag or rotate
         in the fingers while the arm lifts, transits and rolls it over the mug. -->
    <weld name="weld_mug" body1="b_gripper_base" body2="mug" active="false" solref="0.006 1"/>
    <weld name="weld_bottle" body1="a_gripper_base" body2="water_bottle" active="false" solref="0.006 1"/>
  </equality>
</mujoco>
